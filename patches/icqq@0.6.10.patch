+                id2: this.parsed.anon[4],
+                name: String(this.parsed.anon[3]),
+                color: String(this.parsed.anon[7]),
+                expire_time: this.parsed.anon[5],
+                flag: String(this.parsed.anon[3]) + "@" + this.parsed.anon[2].toBase64(),
