+    },
+    0x148: function (info) {
+        return new Writer()
+            .writeTlv(info.id.slice(0, 32))
+            .writeU32(info.appid)
+            .writeU32(info.appid)
+            .writeU32(info.appid === 16 ? 16 : info.subid)
+            .writeTlv(info.ver)
+            .writeTlv(info.sign.length ? info.sign : info.id.slice(0, 32));
