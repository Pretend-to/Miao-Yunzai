+            .writeU32(2)
+            .writeU16(0);
+    },
+    0x1d: function () {
+        return new Writer().writeU8(1).writeU32(this.apk.bitmap).writeU32(0).writeU8(0).writeU32(0);
+    },
+    0x1f: function () {
+        return new Writer()
+            .writeU8(0) // isRoot
+            .writeTlv(this.device.os_type) // OS type
+            .writeTlv(this.device.version.release) // OS version
+            .writeU16(2) // Network Type
+            .writeTlv(this.device.sim) // simOperatorName
+            .writeTlv(BUF0)
+            .writeTlv(this.device.apn); // APN
+    },
+    0x33: function () {
+        return new Writer().writeBytes(this.device.guid);
+    },
+    0x35: function (deviceType) {
+        return new Writer().writeU32(deviceType);
+    },
+    0x66: function (deviceType) {
+        return new Writer().writeU32(deviceType);
+    },
+    0xd1: function () {
+        const buf = pb.encode({
+            1: {
+                1: this.apk.display,
+                2: this.device.model,
+            },
+            4: {
+                6: 1,
+            },
+        });
+        return new Writer().writeBytes(buf);
+    },
+    0x100: function (sub_id, main_sig_map) {
+        return new Writer()
+            .writeU16(1) // db buf ver
+            .writeU32(this.apk.ssover) // sso ver
+            .write32(this.apk.appid)
+            .writeU32(sub_id ?? this.apk.subid)
+            .writeU32(this.apk.client_ver) // app client ver
+            .writeU32(main_sig_map ?? this.apk.main_sig_map);
+    },
+    0x104: function () {
+        return new Writer().writeBytes(this.sig.t104);
+    },
