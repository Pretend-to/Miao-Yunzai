+    if (single)
+        flag = "~" + flag;
+    return flag;
+}
+/** @cqhttp */
+export function parseFriendRequestFlag(flag) {
+    let single = false;
+    if (flag.startsWith("~")) {
+        flag = flag.slice(1);
+        single = true;
+    }
+    const user_id = parseInt(flag.slice(0, 8), 16);
+    const seq = Number("0x" + flag.slice(8));
+    return { user_id, seq, single };
+}
+/** @cqhttp */
