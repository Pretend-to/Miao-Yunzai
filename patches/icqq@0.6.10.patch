+    async getChatHistory(seq = 0, cnt = 20) {
+        cnt = Number(cnt);
+        if (!seq)
+            seq = await this._getLastSeq();
+        try {
+            if (this.c.useQQNT) {
+                const body = pb.encode({
+                    1: {
+                        1: this.gid,
+                        2: seq - cnt + 1,
+                        3: Number(seq),
+                    },
+                    2: 1,
+                });
+                const payload = await this.c.sendUni("trpc.msg.register_proxy.RegisterProxy.SsoGetGroupMsg", body);
+                const obj = pb.decode(payload)[3], messages = [];
+                if (obj[1] > 0 || !obj[6])
+                    return [];
+                !Array.isArray(obj[6]) && (obj[6] = [obj[6]]);
+                for (const proto of obj[6]) {
+                    try {
+                        messages.push(new GroupMessage(this.c, proto, true));
+                    }
+                    catch { }
+                }
+                return messages;
+            }
+        }
+        catch { }
+        const body = pb.encode({
+            1: this.gid,
+            2: seq - (cnt > 20 ? 20 : cnt) + 1,
+            3: Number(seq),
+            6: 0,
+        });
+        const payload = await this.c.sendUni("MessageSvc.PbGetGroupMsg", body);
+        const obj = pb.decode(payload), messages = [];
+        if (obj[1] > 0 || !obj[6])
+            return [];
+        !Array.isArray(obj[6]) && (obj[6] = [obj[6]]);
+        for (const proto of obj[6]) {
+            try {
+                messages.push(new GroupMessage(this.c, proto));
+            }
+            catch { }
+        }
+        return messages;
+    }
+    /**
+     * 获取群文件下载地址
