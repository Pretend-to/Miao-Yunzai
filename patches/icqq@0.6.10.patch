+        2: 3
+    });
+    const list = Array.isArray(proto[1]) ? proto[1] : [proto[1]];
+    return list.map(v => {
+        return {
+            domain: v[1].toString(),
+            p_skey: String(v[2]), expire_time: v[3],
+            g_tk: calcBkn(v[2].toBuffer()),
+            ...(v.checkTag(4) ? {
+                uskey: v[4].toString(), expire_time_uskey: v[5]
+            } : {})
+        };
+    });
+}
+export async function getClientKey() {
