+/** 一条群消息 */
+export class GroupMessage extends Message {
+    /** 反序列化一条群消息 */
+    static deserialize(client, serialized) {
+        return new GroupMessage(client, pb.decode(serialized));
+    }
+    constructor(client, proto, nt) {
+        super(client, proto, nt);
+        this.message_type = "group";
+        /** 发送方信息 */
+        this.sender = {
+            /** 账号 */
+            user_id: 0,
+            /** uid */
