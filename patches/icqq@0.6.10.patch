+        }
+        else {
+            this.sub_type = "normal";
+            this.anonymous = null;
+            const ext = this.parsed.extra[16] || {};
+            const ext1 = this.parsed.extra[37] || {};
+            if (!ext?.[2])
+                this.sender.nickname = ext?.[1]?.toString() || "";
+            else
