+++ b/lib/core/writer.mjs
@@ -0,0 +1,83 @@
+export default class Writer {
+    constructor() {
+        this.chunks = [];
+        this.totalLength = 0;
+    }
+    /** 获取当前已累积的全部数据（不清空） */
+    get buffer() {
+        return Buffer.concat(this.chunks, this.totalLength);
+    }
+    /** 读取指定数量的数据，并从内部移除已读部分 */
+    read(size) {
+        const all = this.buffer;
+        if (size === undefined)
+            size = all.length;
+        const result = all.slice(0, size);
+        // 移除已读部分
+        this.chunks = [all.slice(size)];
+        this.totalLength = all.length - size;
+        return result;
+    }
+    /** 获取全部数据并清空 */
+    drain() {
+        const data = this.buffer;
+        this.clear();
+        return data;
+    }
+    clear() {
+        this.chunks = [];
+        this.totalLength = 0;
+    }
+    push(buf) {
+        this.chunks.push(buf);
+        this.totalLength += buf.length;
+        return this;
+    }
+    writeU8(v) {
+        const buf = Buffer.allocUnsafe(1);
+        buf.writeUInt8(v);
+        return this.push(buf);
+    }
+    writeU16(v) {
+        const buf = Buffer.allocUnsafe(2);
+        buf.writeUInt16BE(v);
+        return this.push(buf);
+    }
+    write32(v) {
+        const buf = Buffer.allocUnsafe(4);
+        buf.writeInt32BE(v);
+        return this.push(buf);
+    }
+    writeU32(v) {
+        const buf = Buffer.allocUnsafe(4);
+        buf.writeUInt32BE(v);
+        return this.push(buf);
+    }
+    writeU64(v) {
+        const buf = Buffer.allocUnsafe(8);
+        buf.writeBigUInt64BE(BigInt(v));
+        return this.push(buf);
+    }
+    writeBytes(v) {
+        const buf = typeof v === 'string' ? Buffer.from(v) : Buffer.from(v);
+        return this.push(buf);
+    }
+    writeWithLength(v) {
+        const body = typeof v === 'string' ? Buffer.from(v) : Buffer.from(v);
+        return this.writeU32(body.length + 4).writeBytes(body);
+    }
+    writeTlv(v) {
+        const body = typeof v === 'string' ? Buffer.from(v) : Buffer.from(v);
+        return this.writeU16(body.length).writeBytes(body);
+    }
+    /** 兼容流：返回当前总长度 */
+    get readableLength() {
+        return this.totalLength;
+    }
+    /** 将数据插入可读队列的头部（模拟 stream.unshift） */
+    unshift(chunk) {
+        this.chunks.unshift(chunk);
+        this.totalLength += chunk.length;
+        return this; // 支持链式调用
+    }
+}
