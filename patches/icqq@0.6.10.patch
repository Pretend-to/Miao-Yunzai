+import { fileURLToPath } from "url";
+import * as path from "path";
+import * as fs from "fs";
+
+// ESM globals
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+/**
+ *  如需更新，替换最新 JSON 数据即可
+ *  @see https://github.com/vikiboss/face/blob/main/face/metadata.json
+ */
+const faceData = JSON.parse(fs.readFileSync(path.resolve(__dirname, './faceData.json'), "utf-8"));
+/** 表情字典 */
+export const facemap = Object.fromEntries(faceData.map((item) => {
+    const entry = { text: item.describe };
+    // 保留原逻辑，如果是超级表情，则设置 stickerType 为 1
+    if (item.stickerId > 0 && item.emojiType === "SUPER_EMOJI") {
+        entry.stickerId = String(item.stickerId);
+        entry.stickerType = 1;
+    }
+    return [item.id, entry];
+}));
+/** 戳一戳字典 */
+export const pokemap = {
+    0: "回戳",
+    1: "戳一戳",
+    2: "比心",
+    3: "点赞",
